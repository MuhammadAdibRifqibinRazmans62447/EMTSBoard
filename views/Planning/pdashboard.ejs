<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/header.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>Homepage</title>

    <style>
       /* page container */
/* ================================
   MAIN CONTENT
================================ */
body {

    background:
    linear-gradient(
        135deg,
        #f0f7ff,
        #dbeafe
    );

    min-height:100vh;

}






.hub-content {
    margin-top: 150px;
    display: flex;      /* or display: grid; */
    justify-content: center;
    gap: 90px;
    flex-direction: column; 
   
}

.card-box {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 50px;
}

/* tile wrapper */
.hub-item {
    text-align: center;
    animation: float var(--float-duration) ease-in-out infinite;
    animation-delay: var(--float-delay);
 
    cursor: pointer;
}

/* .hub-item:hover {
    transform: translateY(-8px) scale(1.03);
} */


@keyframes float {
    0% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(calc(var(--float-distance) * -1));
    }

    100% {
        transform: translateY(0);
    }
}


/* card style */

.hub-card {
    width: 200px !important;
    height: 200px !important;

    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 50%;
    overflow: visible;
 
    display: flex;
    justify-content: center;
    align-items: center;

    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(12px);

    box-shadow:
        0 10px 30px rgba(0,0,0,0.15),
        inset 0 0 20px rgba(255,255,255,0.08);

    transition: 
        transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.6s ease;
     
    
}


.notification-badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 34px;
    height: 34px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: red;
    color: white;
    font-size: 15px;
    font-weight: 600;
    z-index: 999;
    animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.2);
  }
  100% {
    box-shadow: 0 0 0 20px rgba(0, 0, 0, 0);
  }
}

.hub-item:hover {
    animation-play-state: paused;
   
}

.hub-item:hover .hub-card {
    transform: scale(1.06);   
    box-shadow:
        0 15px 40px rgba(0,0,0,0.25),
        0 0 25px rgba(100,180,255,0.35);
}

.hub-item:hover .hub-card::before {
    opacity: 1;
}



/* .hub-item:hover .hub-card {
    box-shadow: 0 12px 28px rgba(0,0,0,0.15);
} */



/* image */
.hub-card img {
     width: 120px;
    height: 120px;
    object-fit: contain;
    margin: auto;
}

/* title */
.hub-title {
    margin-top: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-align: center;
}

.segement{

display: flex;



}
.hub-card svg {
    width: 130px !important;
    height: 130px !important;
    max-width: none !important;
}



    </style>
</head>
<body>


<%- include('../partials/headerPlanning') %>

<div class="container-fluid pt4">


<div class="hub-content">

    <div class="card-box">
    
        <div class="Segement" onclick="GotoReuqest()">

            <div class="hub-item">
                <div class="card hub-card" >
                    <i data-lucide="notebook-tabs" class="request-icon"></i>
                        <% if (totalActive > 0) { %>
                            <div class="notification-badge">
                                <%= totalActive %>
                            </div>
                        <% } %>
                </div>
            </div>
            <div class="hub-title">E-mts Requests</div>

        </div>  

       <div class="Segement" onclick="GotoHistory()">
            <div class="hub-item">
                <div class="card hub-card" >
                    <i data-lucide="history"></i>
                                            <% if (totalComplete > 0) { %>
                            <div class="notification-badge">
                                <%= totalComplete %>
                            </div>
                        <% } %>
                </div>
               
            </div>
            <div class="hub-title">History</div>
        </div>

        <!-- <div class="Segement" onclick="GotoHistory()">

            <div class="hub-item">
                <div class="card hub-card">
                    <img src="/img/icon1.png" class="card-img-top" alt="">
                </div>
                
            </div>
               <div class="hub-title">History</div>

        </div> -->


    </div>

    <!-- row 2 -->
    
    <div class="card-box">
    <% if (user.role === 'Admin') { %>


       <div class="Segement" onclick="GotoEditUser()">
            <div class="hub-item">
                <div class="card hub-card" >
                    <i data-lucide="user"></i>
                </div>
               
            </div>
            <div class="hub-title">User Management</div>
        </div>

            <% }else{ %>
                 <div class="Segement" onclick="GotoEditProfile()">

                    <div class="hub-item">
                        <div class="card hub-card" style="width:18rem;">
                        <i data-lucide="user-cog"></i>
                            
                        </div>
                    </div>
                    <div class="hub-title">Edit Profile</div>

                </div>  


     <% } %>



    </div>


</div>



</div>

   
<script src="https://unpkg.com/lucide@latest"></script>

<script>
const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");

const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();

function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);

function GotoReuqest(){

window.location.href ="/E-mts/planning/request-list";


}



function GotoHistory(){

window.location.href ="/E-mts/planning/history-planning";


}

function GotoEditProfile(){

window.location.href ="/E-mts/planning/editProfile";


}


// function GotoList(){

// window.location.href ="/E-mts/board/list-board-admin";


// }


function GotoEditUser(){


    window.location.href ="/E-mts/planning/Go-to-edit";
}




document.querySelectorAll('.hub-item').forEach(e=>{

    const duration = 4 + Math.random() * 2; // 4s - 8s
    const delay = Math.random() * 3;        // 0s - 3s
    const distance = 5 + Math.random() * 12; // 5px - 15px

    e.style.setProperty('--float-duration', `${duration}s`);
    e.style.setProperty('--float-delay', `${delay}s`);
    e.style.setProperty('--float-distance', `${distance}px`);

})

 lucide.createIcons();


</script>

    
</body>
</html>