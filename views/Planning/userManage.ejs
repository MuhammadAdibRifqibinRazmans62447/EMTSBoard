// });

$('#exampleModal').on('hidden.bs.modal', function () {

    const modal = $(this);

    // Hide all passwords
    modal.find('.password-input').attr('type', 'password');

    // Show normal eye
    modal.find('.icon-eye1').show();

    // Hide eye-off
    modal.find('.icon-eye-off1').hide();

});


$('#EditModal').on('hidden.bs.modal', function () {

    const modal = $(this);

    // Hide all passwords
    modal.find('.password-input').attr('type', 'password');

    // Show normal eye
    modal.find('.icon-eye1').show();

    // Hide eye-off
    modal.find('.icon-eye-off1').hide();

});


document.querySelectorAll('.toggle-password-btn').forEach(button => {

    button.addEventListener('click', function () {

        // 1. Find the password container
        const container =
            this.closest('.input-group-password');

        // 2. Find the password input inside that container
        const password =
            container.querySelector('.password-input');

        // 3. Find the eye icons inside this button
        const eye =
            this.querySelector('.icon-eye1');

        const eyeOff =
            this.querySelector('.icon-eye-off1');

        // 4. Check whether password is currently hidden
        if (password.type === 'password') {

            // Show password
            password.type = 'text';

            // Change eye icon
            eye.style.display = 'none';
            eyeOff.style.display = 'block';

        } else {

            // Hide password
            password.type = 'password';

            // Change eye icon back
            eye.style.display = 'block';
            eyeOff.style.display = 'none';
        }

    });

});

const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();







function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);




    </script>
</body>
</html>