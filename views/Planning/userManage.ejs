<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css">

<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/usertable.css">


    <title>User Management Plannning</title>
</head>
<body>
    <%- include('../partials/headerPlanning') %>
    <% if(success.length > 0){ %>
    <div class="alert alert-success">
        <%= success[0] %>
    </div>
<% } %>

<% if (error.length > 0) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

    <br>
    <br>
    <h1 class="mt-4 text-center">User Management</h1>
    <br>
    <br>
    <br>
    

<div class="container my-4">
            <div class="d-flex justify-content-end align-items-center gap-2 sp">
                <input
                    type="text"
                    id="searchInput"
                    class="form-control"
                    placeholder="Search users..."
                    style="width: 250px;">

                <button data-bs-toggle="modal" data-bs-target="#exampleModal">
                    <span>ADD</span>
                </button>
            </div>        
  <div class="card request-card shadow border-0 rounded-4">

    <div class="card-header text-white text-center fw-bold rounded-top-4">
      <img src="/img/user.svg" width="18" height="18"></i> User List
    </div>

    <div class="card-body p-0">

      <div class="table-container">

        <table id="myTable" class="table table-hover align-middle text-center mb-0">

          <thead>
            <tr>
              <th>No</th>
              <th>Employee ID</th>
              <th>Name</th>
              <th>Department</th>
              <th>Role</th>
              <th>Status</th>
              <th>E-mail</th>
              <th>Action</th>
            </tr>
          </thead>


          <tbody>

         <% if (lists.length > 0) { %>

            <% lists.forEach((list,index) => { %>
            <tr>
                <td>
                  <%= index + 1%>
                </td>

              <td>
                  <%= list.employee_id%>
                </td>
             <td>
                  <%= list.name%>
             </td>
             <td>
                  <%= list.dept%>
             </td>
             <td>
                  <%= list.role_name%>
             </td>
              <td>
                    <%
                        let stageText = list.active == 1 ? 'Active' : 'Deactive';
                        let badgeClass = list.active == 1 ? 'bg-success' : 'bg-danger';
                    %>

                    <span class="badge <%= badgeClass %>">
                        <%= stageText %>
                    </span>
                </td>
                <td>
                   <%= list.email%>
                </td>
                <td>
                    <div 
                        class="tbBtn editBtn"
                        data-bs-toggle="modal"
                        data-bs-target="#EditModal"
                        data-id="<%= list.employee_id %>"
                        data-pass="<%= list.password %>"
                        data-name="<%= list.name %>"
                        data-dept="<%= list.dept %>"
                        data-mail="<%= list.email %>"
                        data-position="<%= list.role_name %>">
                        Edit
                  </div>
                    <div class="tbBtn switchbtn" 
                        onclick="switchStatus('<%= list.employee_id %>', '<%= list.active %>')">
                            <% if (list.active === 1) { %>
                                Inactive
                            <% } else { %>
                                Active
                            <% } %>
                    </div>

                    <div class="tbBtn deletebtn" 
                        onclick="deleteUser('<%= list.employee_id %>')">
                           Delete
                    </div>

                </td>




            </tr>

         <% }) %>

          <% } else { %>

            <tr>
              <td colspan="12" class="text-muted py-4">
                NO DATA
              </td>
            </tr>

          <% } %>



            <!-- <tr>
                <td>1</td>
                <td>5004125081</td>
                <td>Adib</td>
                <td>Production</td>
                <td>Admin</td>
                <td> <span class="badge bg-success">Active</span></td>
                <td>
                    <div class="tbBtn editBtn">
                        Edit
                    </div>
                    <div class="tbBtn deleteBtn">
                        Delete
                    </div>

                </td>
            </tr> -->

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>







<div class="modal fade" id="exampleModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Add User</h1>

        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>

      <div class="modal-body">

        <form id="addUserForm" method="POST" action="/E-mts/planning/addUser">

          <div class="row">

            <div class="col-sm-12">

              <div class="row g-3">

                <div class="form-group col-sm-6">
                  <label for="username" class="form-label">
                    ID<span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="id" 
                         id="username" 
                         required
                         pattern="\d{10}" 
                         title="ID must be exactly 10 digits">
                </div>


                <div class="form-group col-sm-6">
                  <label for="name" class="form-label">
                    Name <span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="name" 
                         id="name" 
                         required>
                </div>


                <div class="form-group col-sm-6">
                  <label for="password" class="form-label">
                    Password <span class="text-danger">*</span>
                  </label>

                 <div class="input-group-password">
                  <input type="password" 
                        class="form-control rounded-3 password-input" 
                        name="password" 
                        id="password" 
                        placeholder="Enter password" 
                        required 
                        autocomplete="off">
                         <button type="button" class="toggle-password-btn" id="togglePassword1" aria-label="Show password as plain text.">

                             <!-- Eye On -->
                <svg class="icon-eye1" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"></path>
                </svg>
                <!-- Eye Off (initially hidden) -->
                <svg class="icon-eye-off1" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                    <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"></path>
                </svg>
                           



                         </button>

                      </div>


                </div>


                <div class="form-group col-sm-6">

                  <label for="position" class="form-control-label">
                    Position <span class="text-danger">*</span>
                  </label>

                  <select class="form-control" 
                          name="position" 
                          id="position" 
                          required>

                    <option value="" disabled selected>
                      Select position
                    </option>

                    <option value="User">
                      User
                    </option>

                    <option value="Admin">
                      Admin
                    </option>

                  </select>

                </div>


                <div class="form-group col-sm-6">
                  <label for="Department" class="form-label">
                    Department <span class="text-danger"></span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="Department" 
                         id="Department" 
                         value="<%= user.dept%>" readonly>

                  
                </div>

                 <div class="form-group col-sm-6">
                  <label for="email" class="form-label">
                    E-mail <span class="text-danger"></span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="email" 
                         id="email" 
                        required>

                  
                </div>


              </div>

            </div>

          </div>

        </form>

      </div>


      <div class="modal-footer">

        <button type="button" 
                class="btn btn-secondary" 
                data-bs-dismiss="modal">
          Close
        </button>


        <!-- Connected to addUserForm -->
        <button type="submit" 
                id="submitAdd" 
                class="btn btn-primary"
                form="addUserForm">
          Submit
        </button>

      </div>


    </div>
  </div>

</div>






<div class="modal fade" id="EditModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="EditModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Edit User</h1>

        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>


      <div class="modal-body">

        <form id="EditUserForm" method="POST" action="/E-mts/planning/editUser">

          <div class="row">

            <div class="col-sm-12">

              <div class="row g-3">

                <div class="form-group col-sm-6">
                  <label for="id" class="form-label">
                    ID<span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="id" 
                         id="edit_id" 
                         required
                         pattern="\d{10}" 
                        readonly>
                </div>


                <div class="form-group col-sm-6">
                  <label for="name" class="form-label">
                    Name <span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="name" 
                         id="edit_name" 
                         required>
                </div>


                <div class="form-group col-sm-6">
                  <label for="password" class="form-label">
                    Password <span class="text-danger">*</span>
                  </label>

                    <div class="input-group-password">
                        <input type="password" 
                              class="form-control rounded-3 password-input" 
                              name="password" 
                              id="edit_password" 
                              required>
                    <button type="button" class="toggle-password-btn" id="togglePassword1" aria-label="Show password as plain text.">

                             <!-- Eye On -->
                <svg class="icon-eye1" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"></path>
                </svg>
                <!-- Eye Off (initially hidden) -->
                <svg class="icon-eye-off1" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                    <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"></path>
                </svg>
                           



                         </button>


                      </div>
                </div>


                <div class="form-group col-sm-6">

                  <label for="position" class="form-control-label">
                    Position <span class="text-danger">*</span>
                  </label>

                  <select class="form-control" 
                          name="position" 
                          id="edit_position" 
                          required>

                    <option value="" disabled selected>
                      Select position
                    </option>

                    <option value="User">
                      User
                    </option>

                    <option value="Admin">
                      Admin
                    </option>

                  </select>

                </div>


                <div class="form-group col-sm-6">

                    <label>Department</label>

                        <select class="form-control"
                                id="edit_dept"
                                name="Department">

                                <% roles.forEach((role) => { %>

                                <option value="<%= role.dep_name %>">
                                    <%= role.dep_name %>
                                </option>

                        <% }) %>
                        </select>

                  
                </div>

              <div class="form-group col-sm-6">

                    <label>E-mail</label>

                       <input type="text" 
                         class="form-control" 
                         name="email" 
                         id="edit_email" 
                         required>
                  
                </div>


              </div>

            </div>

          </div>

        </form>

      </div>


      <div class="modal-footer">

        <button type="button" 
                class="btn btn-secondary" 
                data-bs-dismiss="modal">
          Close
        </button>


        <!-- Connected to addUserForm -->
        <button type="submit" 
                id="submitEdit" 
                class="btn btn-primary"
                form="EditUserForm">
          Submit
        </button>

      </div>


    </div>
  </div>

</div>












<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
<script>
const searchInput = document.getElementById("searchInput");
const table = document.getElementById("myTable");
const rows = table.querySelectorAll("tbody tr");

searchInput.addEventListener("keyup", function () {
    const keyword = this.value.toLowerCase();

    rows.forEach(row => {
        const text = row.textContent.toLowerCase();

        row.style.display = text.includes(keyword) ? "" : "none";
    });
});


document.querySelectorAll(".editBtn").forEach(item => {

    item.addEventListener("click", function () {

        document.getElementById("edit_id").value = this.dataset.id;
        document.getElementById("edit_password").value = this.dataset.pass;
        document.getElementById("edit_name").value = this.dataset.name;
        document.getElementById("edit_dept").value = this.dataset.dept;
        document.getElementById("edit_position").value = this.dataset.position;
        document.getElementById("edit_email").value = this.dataset.mail
        

    });

});

async function  switchStatus(id,active){

      const response = await fetch(`/E-mts/planning/switch/${id}/${active}`, {
            method: "POST"
        });


        if (!response.ok) {
              throw new Error("Server error");
         }
        location.reload();
}

async function deleteUser(id) {

    const confirmed = confirm(
        "Are you sure you want to delete this user?"
    );

    if (!confirmed) {
        return;
    }

    try {

        const response = await fetch(`/E-mts/planning/deleteUser/${id}`, {
            method: "POST"
        });

        if (!response.ok) {
            throw new Error("Server error");
        }

        location.reload();

    } catch (error) {

        console.error(error);
        alert("Failed to delete user.");

    }
}

