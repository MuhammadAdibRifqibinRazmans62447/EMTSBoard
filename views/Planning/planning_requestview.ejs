<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css">

<link rel="stylesheet" href="/css/list.css">
<link rel="stylesheet" href="/css/header.css">
    <title>Request List</title>
</head>
<body>

<%- include('../partials/headerPlanning') %>


    <% if(success.length > 0){ %>
    <div class="alert alert-success">
        <%= success[0] %>
    </div>
<% } %>

<% if (error.length > 0) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>



<div class="pr-stat-cards">
    <div class="pr-stat" data-status="ALL"  style="cursor:pointer">
        <p class="pr-stat__label">Total Request</p>
        <p class="pr-stat__value"><%= total %></p>
    </div>

    <div class="pr-stat" data-status="PENDING"style="cursor:pointer">
        <p class="pr-stat__label">Pending Supervisor</p>
        <p class="pr-stat__value pr-stat__value--orange">
           <%= I1 %>
        </p>
    </div>

    <div class="pr-stat" data-status="date"  style="cursor:pointer">
        <p class="pr-stat__label">Pending Planning (Receive Date)</p>
        <p class="pr-stat__value pr-stat__value--date">
           <%= PL1 %>
        </p>
    </div>

    <div class="pr-stat" data-status="Imaps"  style="cursor:pointer">
        <p class="pr-stat__label">Pending Planning (IMaps)</p>
        <p class="pr-stat__value pr-stat__value--red">
           <%= PL2 %>
        </p>
    </div>

    <div class="pr-stat" data-status="REJECTED"  style="cursor:pointer">
        <p class="pr-stat__label">Pending Recive</p>
        <p class="pr-stat__value pr-stat__value--red">
           <%= W1 %>
        </p>
    </div>

</div>

<div class="approval-card d-none" id="prog">
  <!-- <div class="approval-card" > -->

    <div class="stepper-wrapper">

        <!-- Step 1 -->
      <div class="stepper-item" id="requestor">
          <div class="step-counter">1</div>
          <div class="step-title">Applicant</div>
           <div class="step-name">Waiting...</div>
          <div class="step-id"></div>
          <div class="step-date"></div>
      </div>

        <!-- Step 2 -->
        <div class="stepper-item " id="I1">
            <div class="step-counter">
                2
            </div>

            <div class="step-title">Approval by Supervisor/HOD</div>
            <div class="step-name">Waiting...</div>
            <div class="step-id">-</div>
            <div class="step-date"></div>
        </div>

        <!-- Step 3 -->
        <div class="stepper-item "  id="PL1">
            <div class="step-counter">
                3
            </div>

            <div class="step-title">Approval by Planning</div>
            <div class="step-name">Waiting...</div>
             <div class="step-id">-</div>
            <div class="step-date">-</div>
        </div>

        <div class="stepper-item "id="PL2">
            <div class="step-counter">
                4
            </div>

            <div class="step-title">iMaps Uploaded</div>
            <div class="step-name">Waiting...</div>
             <div class="step-id">-</div>
            <div class="step-date">-</div>
        </div>

        <!-- Step 4 -->
        <div class="stepper-item" id="W1">
            <div class="step-counter">
                5
            </div>

            <div class="step-title">Board Received</div>
            <div class="step-name">Waiting...</div>
             <div class="step-id">-</div>
            <div class="step-date">-</div>
        </div>

    </div>

   

</div>



<div class="container-fluid my-4">
              <div class="d-flex justify-content-end align-items-center gap-2 sp">
                <input
                    type="text"
                    id="searchInput"
                    class="form-control"
                    placeholder="Search Request..."
                    style="width: 250px;">
              </div>

  <div class="card request-card shadow border-0 rounded-4">

<div class="card-header bg-primary text-white fw-bold rounded-top-4 d-flex justify-content-between align-items-center">
    
    <span>📋 Request Status</span>

<button class="btn btn-light" onclick="download()">
    Download
</button>

</div>

    <div class="card-body p-0">

      <div class="table-container">

        <table id="myTable" class="table table-hover align-middle text-center mb-0">

          <thead>
            <tr>
              <th>Reference No.</th>
              <th>Issue Date</th>
              <th>Requestor</th>
              <th>ID</th>
              <th>Department</th>
              <th>EXT</th>
              <th>Issue JOC</th>
              <th>Return JOC</th>
              <th>Spoilage JOC</th>
              <th>Remarks</th>
              <th>Collection Date</th>
              <th>Details</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>


          <tbody>

          <% if (Requests.length > 0) { %>

            <% Requests.forEach((Request) => { %>

              
              <tr>


                <td class="fw-semibold clickable-text" onclick="progress('<%= Request.MNumber %>',this)">
                <%= Request.MNumber %>
                </td>

                <td>
                <%= Request.issuedate ? new Date(Request.issuedate).toLocaleDateString('en-GB') : '' %>
                </td>

                <td>
                  <%= Request.req_name %>
                </td>

                <td>
                  <span class="text-muted">
                    <%= Request.req_id %>
                  </span>
                </td>

                <td>
                  <span class="badge bg-light text-dark">
                    <%= Request.req_dep %>
                  </span>
                </td>

                <td>
                  <%= Request.req_ext %>
                </td>

                <td>
                  <%= Request.issuejoc %>
                </td>

                <td>
                  <%= Request.returnjoc %>
                </td>

                <td>
                  <%= Request.spoilagejoc %>
                </td>

                <td>
                  <%= Request.remark %>
                </td>


            
                <% if (Request.stage === 'PL1') { %>
                  <td>
                      <div class="blink_me"
                       
                          style=" color: #ffc107; font-weight: 600;">
                          
                          <%= Request.receiveDate
                              ? new Date(Request.receiveDate).toLocaleDateString('en-GB')
                              : 'Add Date' %>

                      </div>
                  </td>

                <% } else { %>

                    <td class="fw-semibold">
                        <%= Request.receiveDate
                            ? new Date(Request.receiveDate).toLocaleDateString('en-GB')
                            : 'Add Date' %>
                    </td>

                <% } %>
<!-- make it pulsing -->

                <td>
                  <button class="btn btn-sm btn-outline-primary" onclick="itemModal('<%= Request.MNumber %>')">
                    View
                  </button>
                </td>



                <td>

                              <%
                  let stageText = '';
                  let badgeClass = '';

                  switch (Request.stage) {

                      case 'PL1':
                          stageText = 'Please confirm the receive Date';
                          badgeClass = 'bg-warning text-dark';
                          break;

                      case 'PL2':
                          stageText = 'Uploaded into Imaps';
                          badgeClass = 'bg-info text-dark';
                          break;

                      case 'I2':
                          stageText = 'Waiting for resubmission';
                          badgeClass = 'bg-warning text-dark';
                          break;

                      case 'PL3':
                          stageText = 'Waiting for new recieve date';
                          badgeClass = 'bg-danger text-dark';
                          break;

                      case 'W1':
                          stageText = 'Waiting for Board Production';
                          badgeClass = 'bg-secondary';
                          break;

                      default:
                          stageText = Request.stage;
                          badgeClass = 'bg-light text-dark';
                  }
              %>

              <span class="badge <%= badgeClass %>">
                  <%= stageText %>
              </span>

                </td>
              
                <td>
                    <% if (Request.stage === 'PL1') { %>
                            <div class="vista-button approvebtn"
                                data-bs-toggle="modal"
                                data-bs-target="#ApproveModal"
                                data-date="<%= Request.receiveDate ? new Date(Request.receiveDate).toLocaleDateString('en-GB') : '' %>"
                                data-m="<%= Request.MNumber %>">

                                <div>Confirm Date</div>

                            </div>

                    <% } else if (Request.stage === 'PL2') { %>

                        <div class="vista-button" onclick="uploaded('<%= Request.MNumber %>')">
                            <div>Request Uploaded</div>
                        </div>

                    <% } else { %>

                        <span style="color: #999;">—</span>

                    <% } %>
                </td>
                


              </tr>

            <% }) %>


          <% } else { %>

            <tr>
              <td colspan="12" class="text-muted py-4">
                No active requests
              </td>
            </tr>

          <% } %>


          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>


