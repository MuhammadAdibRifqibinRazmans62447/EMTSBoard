<div class="modal fade"
     id="ApproveModal"
     tabindex="-1"
     data-bs-backdrop="static"
     aria-labelledby="ApproveModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered" style="max-width: 90%;">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="ApproveModalLabel">
                    Approve Date
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>


            <!-- BODY -->
            <div class="modal-body">

                <form id="approveDate"
                      method="POST"
                      action="/E-mts/planning/approveDate">

                    <div class="row g-3">

                        <!-- M NUMBER -->
                        <div class="form-group col-sm-6">

                            <label for="Mnumber" class="form-label">
                               Reference No
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="Mnumber"
                                   id="Mnumber"
                                   readonly>

                        </div>


                        <!-- RECEIVE DATE -->
                        <div class="form-group col-sm-6">

                            <label for="receiveDate" class="form-label">
                                Collection Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="receiveDate"
                                   id="receiveDate"
                                   required>

                        </div>


                        <!-- APPROVE -->

                        <div class="form-group col-sm-12 approveSection">

                            <label class="form-label">
                                Approve
                                <span class="text-danger">*</span>
                            </label>

                            <div class="d-flex gap-4">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="approve"
                                           id="approveYes"
                                           value="yes"
                                           onclick="toggledate(true)"
                                           required>

                                    <label class="form-check-label"
                                           for="approveYes">
                                        Yes
                                    </label>

                                </div>


                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="approve"
                                           id="approveNo"
                                           value="no"
                                           onclick="toggledate(false)">

                                    <label class="form-check-label"
                                           for="approveNo">
                                        No
                                    </label>

                                </div>

                            </div>

                        </div>


                        <!-- RECOMMENDED DATE -->
                         
                        <div class="form-group col-sm-6 d-none"
                             id="recommendedDateDiv">

                            <label for="recommendedDate" class="form-label">
                                Recommended Collection Date
                                <span class="text-danger"></span>
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="recommendedDate"
                                   id="recommendedDate">

                        </div>


                        <!-- REASON -->
                        <div class="form-group col-sm-6 d-none"
                             id="modalreason">

                            <label for="reason" class="form-label">
                                Reason
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="reason"
                                   id="reason">

                        </div>

                    </div>

                </form>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button type="submit"
                        id="submitApprove"
                        class="btn btn-primary"
                        form="approveDate">
                    Submit
                </button>

                <button type="button"
                            id="CancleRequest"
                            class="btn btn-danger"
                            onclick="cancleRequest()" disabled>
                        Reject
                </button>


            </div>

        </div>
    </div>

</div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
<script>

let lastrow = null;


async function progress(Mnumber, col) {

    const row = col.closest('tr');
    const progressbar = document.getElementById('prog');

    // Clicking the same row
    if (lastrow === row) {
        row.classList.remove('table-info');
        progressbar.classList.add('d-none');
        lastrow = null;
        return;
    }

    // Remove highlight from previous row
    if (lastrow) {
        lastrow.classList.remove('table-info');
    }

    let refresh = 1;
     document.querySelectorAll('.stepper-item').forEach(stage => {
        stage.classList.remove('completed', 'active','rejected','warning');

        const counter = stage.querySelector('.step-counter');
        const name = stage.querySelector('.step-name');
        const date = stage.querySelector('.step-date');
        const id = stage.querySelector('.step-id');

        if (counter) counter.textContent = refresh;
        if (name) name.textContent = '';
        if (id) id.textContent = '';
        if (date) date.textContent = '-';
        refresh++;
    });
    // Highlight current row
    row.classList.add('table-info');

    // Remember current row
    lastrow = row;

    // Show progress bar
    progressbar.classList.remove('d-none');

    console.log(Mnumber);


    try {
    const response = await fetch(`/E-mts/board/fetchStage/${Mnumber}`)

    const data = await response.json();
    if (!response.ok) {
            throw new Error("Server error");
     }


     

if(data.currentStage.stage !='I2'){
    
    data.pastapproval.forEach(row=>{

          const stage = document.getElementById(row.stage);

          if (!stage) return;

          stage.classList.add("completed");

          stage.querySelector('.step-counter').textContent = '✓';
          stage.querySelector('.step-id').textContent = row.employee_id;
           stage.querySelector('.step-name').textContent = row.approval_name;
          stage.querySelector('.step-date').textContent = new Date(row.action_date).toLocaleDateString('en-GB');
         


    })

   
    if(data.currentStage.stage !='PL3'){

    const stagecurrent = document.getElementById(data.currentStage.stage);
    stagecurrent.querySelector('.step-name').textContent ="Waiting..."
    stagecurrent.classList.add("active")

    }else{

    const stagecurrent = document.getElementById("I1");
    stagecurrent.querySelector('.step-name').textContent ="Date Rejected"
     stagecurrent.querySelector('.step-id').textContent ="--"
     stagecurrent.querySelector('.step-counter').textContent = 'X';
    stagecurrent.classList.add("rejected")
    stagecurrent.querySelector('.step-date').textContent =  new Date(data.currentStage.created_at).toLocaleDateString('en-GB');


    }

}


    const requestor = document.getElementById("requestor");

    // Remove previous status classes
    requestor.classList.remove("completed", "warning");

    // Set status icon and class
    if (data.currentStage.stage !== 'I2') {
        requestor.querySelector('.step-counter').textContent = '✓';
        requestor.classList.add("completed");
    } else {
        requestor.querySelector('.step-counter').textContent = '⚠️';
        requestor.classList.add("warning");
    }

    // Set requestor information
    requestor.querySelector('.step-id').textContent = data.requestor.req_id;
    requestor.querySelector('.step-name').textContent = data.requestor.req_name;
    requestor.querySelector('.step-date').textContent =
        new Date(data.requestor.issuedate).toLocaleDateString('en-GB');

    }catch (error) {

        console.error(error);

    }
   

}


function toggledate(enable) {

    const reasonDiv = document.getElementById('modalreason');
    const reasonInput = document.getElementById('reason');

    const recommendedDiv = document.getElementById('recommendedDateDiv');
    const recommendedInput = document.getElementById('recommendedDate');

    const rejectbtn = document.getElementById('CancleRequest');

    if (enable) {

        // YES
        reasonDiv.classList.add('d-none');
        reasonInput.value = "";
     

        recommendedDiv.classList.add('d-none');
        recommendedInput.value = "";

        rejectbtn.disabled = true;


    } else {

        // NO
        reasonDiv.classList.remove('d-none');
       

        recommendedDiv.classList.remove('d-none');

         rejectbtn.disabled = false;
    
    }
}



document.querySelectorAll('.approvebtn').forEach(button => {

    button.addEventListener('click', function () {

        const date = this.dataset.date;
        const mNumber = this.dataset.m;

        const receiveDate = document.getElementById('receiveDate');
        const yes = document.getElementById('approveYes');
        const section = document.querySelector('.approveSection');

        // Reset first
        receiveDate.value = "";
        

        document.getElementById('Mnumber').value = mNumber;

        // Convert DD/MM/YYYY → YYYY-MM-DD
        console.log(date);

        if (date) {

            const parts = date.split('/');

            if (parts.length === 3) {

                const formattedDate =
                    `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;

                receiveDate.value = formattedDate;
            }

        } else {

            yes.checked = true;
            toggledate(true);

            
        }

    });

});



async function cancleRequest() {

    if (!confirm("Reject Request?")) {
        return;
    }

    const Mnumber = document.getElementById("Mnumber").value;
    const reason = document.getElementById("reason").value;

    // Check only — keep original reasons unchanged
    if (reason.trim() === "") {
        alert("Enter the reason");
        return;
    }

    try {

        const response = await fetch("/E-mts/planning/cancleRequest", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                Mnumber,
                reason
            })
        });

        if (!response.ok) {
            throw new Error(`Server error: ${response.status}`);
        }

        const data = await response.json();

        if (!data.success) {
            throw new Error(data.message || "Failed to cancel request");
        }

        alert("Request rejected successfully.");

        location.reload();

    } catch (error) {

        console.error("Cancel request error:", error);
        alert(error.message || "Failed to cancel request.");

    }
}



async function uploaded(Mnumber) {

    if (!confirm('Are you sure you want to submit this request?')) {
        return;
    }

    try {

        const response = await fetch('/E-mts/planning/updateImaps', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Mnumber: Mnumber
            })
        });

        if (!response.ok) {
            throw new Error('Server error');
        }

        const data = await response.json();

    if (data.success) {
            alert('Request uploaded successfully.');

            // Optional: reload page
            location.reload();
        }

    } catch (error) {

        console.error(error);
        alert('Failed to update request.');

    }
}





const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();







function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);


async function itemModal(Mnumber) {

    try{

      const response = await fetch(`/E-mts/planning/fetchItems/${Mnumber}`);
        if (!response.ok) {
            throw new Error("Server error");
        }
         const data = await response.json();

         let tbody = document.querySelector(".inmodal .tbodymodal");

         tbody.innerHTML = '';

        if (data.length > 0) {
            data.forEach((e, index) => {

              let no = index +1;

              tbody.innerHTML += `
                  <tr style="border-bottom: 1px solid #edf0f3;">
                      <td style="padding: 11px 14px; text-align:center;">${no}</td>
                      <td style="padding: 11px 14px;">${e.MNumber}</td>
                      <td style="padding: 11px 14px;">${e.itemno}</td>
                      <td style="padding: 11px 14px;">${e.itemdesc}</td>
                      <td style="padding: 11px 14px;">${e.itemcat}</td>
                      <td style="padding: 11px 14px; text-align:center;">${e.reqqty}</td>
                      <td style="padding: 11px 14px; text-align:center;">${e.remark || '-'}</td>
                  </tr>
              `;
            });

                const modal = new bootstrap.Modal(document.getElementById('exampleModal'));
                modal.show();
                
        } else {

                      tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center">
                        No Data
                    </td>
                </tr>
            `;

        }

      



    }catch(error){

          console.error("Error fetching items:", error);

    }

  
}


