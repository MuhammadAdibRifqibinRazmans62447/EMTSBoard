<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css">

<link rel="stylesheet" href="/css/header.css">
    <title>Document</title>


    <style>
        .input-group-password {
    position: relative;
}

.input-group-password .form-control {
    width: 100%;
    padding-right: 45px;
}

/* Eye button */
.input-group-password .toggle-password-btn {
    position: absolute;
    top: 50%;
    right: 8px;
    transform: translateY(-50%);

    width: 32px;
    height: 32px;

    padding: 0;
    border: none;
    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #6c757d;
    cursor: pointer;
}

/* SVG */
.input-group-password .toggle-password-btn svg {
    width: 19px;
    height: 19px;
}

/* Hover */
.input-group-password .toggle-password-btn:hover {
    color: #212529;
}

input[type="password"]::-ms-reveal {
    display: none;
}
    </style>
</head>
<body>

       <% if (user.rc === 'Approval') { %>

    <%- include('../partials/headerSV') %>

<% } else { %>

    <%- include('../partials/header') %>

<% } %>
    <% if(success.length > 0){ %>
    <div class="alert alert-success">
        <%= success[0] %>
    </div>
<% } %>

<% if (error.length > 0) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

    <br>
    <br>
    <h1 class="mt-4 text-center">EDIT PROFILE</h1>
    <br>
    <br>
    <br>

<div class="container my-4">

    <div class="d-flex justify-content-end align-items-center gap-2 sp">

    </div>


    <div class="card shadow-sm mt-3">

        <div class="card-header">
            <h4 class="mb-0">
                <i data-lucide="user-round-pen"></i>
                Edit Profiles
            </h4>
        </div>

        <div class="card-body">

            <form action="/E-mts/board/profileUser" method="POST" onsubmit="return confirmProfileUpdate()">

                <!-- Hidden ID -->
                <input 
                    type="hidden"
                    name="employee_id"
                    value="<%= info.employee_id %>">


                <div class="row g-3">

                    <!-- Employee ID -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Employee ID
                        </label>

                        <input 
                            type="text"
                            class="form-control"
                            value="<%= info.employee_id %>"
                            readonly>
                    </div>


                    <!-- Name -->
                    <div class="col-md-6">
                        <label for="edit_name" class="form-label">
                            Name <span class="text-danger">*</span>
                        </label>

                        <input 
                            type="text"
                            class="form-control"
                            id="edit_name"
                            name="name"
                            value="<%= info.name %>"
                            required>
                    </div>


                    <!-- Department -->
                    <div class="col-md-6">
                        <label for="edit_dept" class="form-label">
                            Department
                        </label>

                        <input 
                            type="text"
                            class="form-control"
                            id="edit_dept"
                            value="<%= info.dept %>"
                            readonly>
                    </div>


                    


                    <!-- Email -->
                    <div class="col-md-6">
                        <label for="edit_email" class="form-label">
                            Email
                        </label>

                        <input 
                            type="email"
                            class="form-control"
                            id="edit_email"
                            name="email"
                            value="<%= info.email || '' %>" required>
                    </div>

                </div>


                <hr class="my-4">


                <!-- Password -->
                <h5>Change Password</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="edit_password" class="form-label">
                            New Password
                        </label>
                <div class="input-group-password">
                        <input 
                            type="password"
                            class="form-control password-input"
                            id="edit_password"
                            name="password"
                            value="<%= info.password || '' %>" required>

                                                                                   <button type="button" class="toggle-password-btn" id="togglePassword1" aria-label="Show password as plain text.">

                             <!-- Eye On -->
                <svg class="icon-eye1" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"></path>
                </svg>
                <!-- Eye Off (initially hidden) -->
                <svg class="icon-eye-off1" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                    <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"></path>
                </svg>


                         </div>
                    </div>



                </div>


                <div class="d-flex justify-content-end mt-4">

                    <button 
                        type="submit"
                        class="btn btn-primary">

                        <i data-lucide="save"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>       
<script src="https://unpkg.com/lucide@latest"></script>

<script>


function confirmProfileUpdate() {

    const confirmUpdate = confirm(
        "Are you sure you want to save these changes?"
    );

    return confirmUpdate;
}


document.querySelectorAll('.toggle-password-btn').forEach(button => {

    button.addEventListener('click', function () {

        // 1. Find the password container
        const container =
            this.closest('.input-group-password');

        // 2. Find the password input inside that container
        const password =
            container.querySelector('.password-input');

        // 3. Find the eye icons inside this button
        const eye =
            this.querySelector('.icon-eye1');

        const eyeOff =
            this.querySelector('.icon-eye-off1');

        // 4. Check whether password is currently hidden
        if (password.type === 'password') {

            // Show password
            password.type = 'text';

            // Change eye icon
            eye.style.display = 'none';
            eyeOff.style.display = 'block';

        } else {

            // Hide password
            password.type = 'password';

            // Change eye icon back
            eye.style.display = 'block';
            eyeOff.style.display = 'none';
        }

    });

});





const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();







function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);
 lucide.createIcons();

</script>
    
</body>
</html>