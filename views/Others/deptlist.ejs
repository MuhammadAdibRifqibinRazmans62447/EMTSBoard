<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css">

<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/usertable.css">

    <title>Department Managment</title>
</head>
<body>

           <% if (user.rc === 'Approval') { %>

    <%- include('../partials/headerSV') %>

<% } else { %>

    <%- include('../partials/header') %>

<% } %>


    <% if(success.length > 0){ %>
    <div class="alert alert-success">
        <%= success[0] %>
    </div>
<% } %>

<% if (error.length > 0) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

    <br>
    <br>
    <h1 class="mt-4 text-center">Department Management</h1>
    <br>
    <br>
    <br>
    

<div class="container my-4">
            <div class="d-flex justify-content-end align-items-center gap-2 sp">
                <input
                    type="text"
                    id="searchInput"
                    class="form-control"
                    placeholder="Search users..."
                    style="width: 250px;">

                <button data-bs-toggle="modal" data-bs-target="#exampleModal">
                    <span>ADD Dept</span>
                </button>
            </div>        
  <div class="card request-card shadow border-0 rounded-4">

    <div class="card-header text-white text-center fw-bold rounded-top-4">
      <img src="/img/user.svg" width="18" height="18"></i> User List
    </div>

    <div class="card-body p-0">

      <div class="table-container">

        <table id="myTable" class="table table-hover align-middle text-center mb-0">

          <thead>
            <tr>
              <th>No</th>
              <th>Department</th>
              <th>Ext</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>


          <tbody>

         <% if (lists.length > 0) { %>

            <% lists.forEach((list,index) => { %>
            <tr>
                <td>
                  <%= index + 1%>
                </td>

              <td>
                  <%= list.dep_name%>
                </td>
             <td>
                  <%= list.EXT%>
             </td>
              <td>
                    <%
                        let stageText = list.active == 1 ? 'Active' : 'Deactive';
                        let badgeClass = list.active == 1 ? 'bg-success' : 'bg-danger';
                    %>

                    <span class="badge <%= badgeClass %>">
                        <%= stageText %>
                    </span>
                </td>
                <td>
                    <div 
                        class="tbBtn editBtn"
                        data-bs-toggle="modal"
                        data-bs-target="#EditModal"
                        data-id="<%= list.dep_id %>"
                        data-name="<%= list.dep_name %>"
                        data-ext="<%= list.EXT %>">
                        Edit
                    </div>
                    <div class="tbBtn switchbtn" 
                        onclick="switchStatus('<%= list.dep_id %>', '<%= list.active %>')">
                         <% if (list.active === 1) { %>
                                Inactive
                            <% } else { %>
                                Active
                            <% } %>
                    </div>

                </td>




            </tr>

         <% }) %>

          <% } else { %>

            <tr>
              <td colspan="12" class="text-muted py-4">
                NO DATA
              </td>
            </tr>

          <% } %>



            <!-- <tr>
                <td>1</td>
                <td>5004125081</td>
                <td>Adib</td>
                <td>Production</td>
                <td>Admin</td>
                <td> <span class="badge bg-success">Active</span></td>
                <td>
                    <div class="tbBtn editBtn">
                        Edit
                    </div>
                    <div class="tbBtn deleteBtn">
                        Delete
                    </div>

                </td>
            </tr> -->

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>







<div class="modal fade" id="exampleModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Add User</h1>

        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>

      <div class="modal-body">

        <form id="addUserForm" method="POST" action="/E-mts/board/addDept">

          <div class="row">

            <div class="col-sm-12">

              <div class="row g-3">

                <div class="form-group col-sm-6">
                  <label for="username" class="form-label">
                    Department Name<span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                        class="form-control" 
                        name="deptname" 
                        id="deptname" 
                        autocomplete="off">
                </div>


                <div class="form-group col-sm-6">
                  <label for="name" class="form-label">
                    EXT <span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                        class="form-control" 
                        name="ext" 
                        id="ext" 
                        required>
                </div>



              </div>

            </div>

          </div>

        </form>

      </div>


      <div class="modal-footer">

        <button type="button" 
                class="btn btn-secondary" 
                data-bs-dismiss="modal">
          Close
        </button>


        <!-- Connected to addUserForm -->
        <button type="submit" 
                id="submitAdd" 
                class="btn btn-primary"
                form="addUserForm">
          Submit
        </button>

      </div>


    </div>
  </div>

</div>






<div class="modal fade" id="EditModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="EditModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Edit User</h1>

        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>


      <div class="modal-body">

        <form id="EditUserForm" method="POST" action="/E-mts/board/editdept">

          <div class="row">

            <div class="col-sm-12">

              <div class="row g-3">
<input type="hidden" name="id" id="edit_id">
                <div class="form-group col-sm-6">
    <label for="edit_deptname" class="form-label">
        Department Name<span class="text-danger">*</span>
    </label>

    <input 
        type="text"
        class="form-control"
        name="deptname"
        id="edit_deptname"
        readonly
        >
</div>


<div class="form-group col-sm-6">
    <label for="edit_ext" class="form-label">
        EXT <span class="text-danger">*</span>
    </label>

    <input 
        type="text"
        class="form-control"
        name="ext"
        id="edit_ext"
        required>
</div>



              </div>

            </div>

          </div>

        </form>

      </div>


      <div class="modal-footer">

        <button type="button" 
                class="btn btn-secondary" 
                data-bs-dismiss="modal">
          Close
        </button>


        <!-- Connected to addUserForm -->
        <button type="submit" 
                id="submitEdit" 
                class="btn btn-primary"
                form="EditUserForm">
          Submit
        </button>

      </div>


    </div>
  </div>

</div>












<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
<script>





const searchInput = document.getElementById("searchInput");
const table = document.getElementById("myTable");
const rows = table.querySelectorAll("tbody tr");

searchInput.addEventListener("keyup", function () {
    const keyword = this.value.toLowerCase();

    rows.forEach(row => {
        const text = row.textContent.toLowerCase();

        row.style.display = text.includes(keyword) ? "" : "none";
    });
});


document.querySelectorAll(".editBtn").forEach(item => {

    item.addEventListener("click", function () {
                console.log("ID:", this.dataset.id);
        console.log("NAME:", this.dataset.name);
        console.log("EXT:", this.dataset.ext);

        document.getElementById("edit_id").value = this.dataset.id;
        document.getElementById("edit_deptname").value = this.dataset.name;
        document.getElementById("edit_ext").value = this.dataset.ext;

    });

});

async function  switchStatus(id,active){

      const response = await fetch(`/E-mts/board/switchDept/${id}/${active}`, {
            method: "POST"
        });


        if (!response.ok) {
              throw new Error("Server error");
         }
        location.reload();
}


// $(document).ready(function () {
//     $('#myTable').DataTable({
//         lengthChange: false,
//         info: false,
//         ordering: false,
//         autoWidth: false
//     });
// });







const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();







function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);




    </script>
</body>
</html>