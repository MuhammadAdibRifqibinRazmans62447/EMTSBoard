<script>


    const searchInput = document.getElementById("searchInput");
const table = document.getElementById("myTable");
const rows = table.querySelectorAll("tbody tr");

searchInput.addEventListener("keyup", function () {
    const keyword = this.value.toLowerCase();

    rows.forEach(row => {
        const text = row.textContent.toLowerCase();

        row.style.display = text.includes(keyword) ? "" : "none";
    });
});



async function cancleRequest(){

        if (!confirm('Cancle Request')) {
        return;
    }

    const Mnumber = document.getElementById("Mnumber").value
    console.log(Mnumber);

    try{

            const response = await fetch('/E-mts/Board/cancleRequest', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Mnumber: Mnumber
            })
        });

        
        const data = await response.json();

    if (data.success) {
            alert('Request uploaded successfully.');

            // Optional: reload page
            location.reload();
        }




    }catch(error){

        console.error(error);
        alert('Failed to delete request.');

    }




}



async function updateRecived(Mnumber) {

    if (!confirm('Board Recieve?')) {
        return;
    }

    try {

        const response = await fetch('/E-mts/Board/boardReceived', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Mnumber: Mnumber
            })
        });

        if (!response.ok) {
            throw new Error('Server error');
        }

        const data = await response.json();

    if (data.success) {
            alert('Request uploaded successfully.');

            // Optional: reload page
            location.reload();
        }

    } catch (error) {

        console.error(error);
        alert('Failed to update request.');

    }
}




const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();



async function itemModal(Mnumber) {

    try{

      const response = await fetch(`/E-mts/board/fetchItems/${Mnumber}`);
        if (!response.ok) {
            throw new Error("Server error");
        }
         const data = await response.json();

         let tbody = document.querySelector(".inmodal .tbodymodal");

         tbody.innerHTML = '';

        if (data.length > 0) {
            data.forEach((e, index) => {

              let no = index +1;

              tbody.innerHTML += `
                  <tr style="border-bottom: 1px solid #edf0f3;">
                      <td style="padding: 11px 14px; text-align:center;">${no}</td>
                      <td style="padding: 11px 14px;">${e.MNumber}</td>
                      <td style="padding: 11px 14px;">${e.itemno}</td>
                      <td style="padding: 11px 14px;">${e.itemdesc}</td>
                      <td style="padding: 11px 14px;">${e.itemcat}</td>
                      <td style="padding: 11px 14px; text-align:center;">${e.reqqty}</td>
                      <td style="padding: 11px 14px; text-align:center;">${e.remark || '-'}</td>
                      <td style="padding: 11px 14px; text-align:center; color:${getStatusColor(e.status)};">${e.status}</td>
                  </tr>
              `;
            });

                const modal = new bootstrap.Modal(document.getElementById('exampleModal'));
                modal.show();
                
        } else {

                      tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center">
                        No Data
                    </td>
                </tr>
            `;

        }

      



    }catch(error){

          console.error("Error fetching items:", error);

    }

  
}



async function itemDate(Mnumber, date) {

    try {

        const response = await fetch(`/E-mts/board/fetchDates/${Mnumber}`);
   
        const d = new Date(date);

        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        
       const formattedDate = `${year}-${month}-${day}`;
        if (!response.ok) {
            throw new Error("Server error");
        }

        const data = await response.json();

        document.getElementById('Mnumber').value = Mnumber;
        document.getElementById('receiveDate').value = formattedDate;
        document.getElementById('originalReceiveDate').value = formattedDate;
     console.log(data[0].recommended_date)
        if (data.length > 0) {

            document.getElementById('recommendedDate').value =
                data[0].recommended_date || '';

            document.getElementById('reason').value =
                data[0].remark || '';
        }

        const modal = new bootstrap.Modal(
            document.getElementById('ApproveModal')
        );

        modal.show();

    } catch (error) {

        console.error(error);

    }
}


document.getElementById('resubmitDate').addEventListener('submit', function(e) {

    const receiveDate =
        document.getElementById('receiveDate').value;

    const originalDate =
        document.getElementById('originalReceiveDate').value;

    if (receiveDate === originalDate || receiveDate === "") {
        e.preventDefault();

        alert('Please select a different Receive Date.');

        return;
    }

});
function getStatusColor(status) {
    switch (status) {
        case 'approve':
            return 'green';
        case 'reject':
            return 'red';
        case 'Pending':
            return 'orange';
        default:
            return 'gray';
    }
  }

let lastrow =null;
async function progress(Mnumber, col) {

    const row = col.closest('tr');
    const progressbar = document.getElementById('prog');

    // Clicking the same row
    if (lastrow === row) {
        row.classList.remove('table-info');
        progressbar.classList.add('d-none');
        lastrow = null;
        return;
    }

    // Remove highlight from previous row
    if (lastrow) {
        lastrow.classList.remove('table-info');
    }

    let refresh = 1;
     document.querySelectorAll('.stepper-item').forEach(stage => {
        stage.classList.remove('completed', 'active','rejected','warning');

        const counter = stage.querySelector('.step-counter');
        const name = stage.querySelector('.step-name');
        const date = stage.querySelector('.step-date');
        const id = stage.querySelector('.step-id');

        if (counter) counter.textContent = refresh;
        if (name) name.textContent = '';
        if (id) id.textContent = '';
        if (date) date.textContent = '-';
        refresh++;
    });
    // Highlight current row
    row.classList.add('table-info');

    // Remember current row
    lastrow = row;

    // Show progress bar
    progressbar.classList.remove('d-none');

    console.log(Mnumber);


    try {
    const response = await fetch(`/E-mts/board/fetchStage/${Mnumber}`)

    const data = await response.json();
    if (!response.ok) {
            throw new Error("Server error");
     }


     

if(data.currentStage.stage !='I2'){
    
    data.pastapproval.forEach(row=>{

          const stage = document.getElementById(row.stage);

          if (!stage) return;

          stage.classList.add("completed");

          stage.querySelector('.step-counter').textContent = '✓';
          stage.querySelector('.step-id').textContent = row.employee_id;
           stage.querySelector('.step-name').textContent = row.approval_name;
          stage.querySelector('.step-date').textContent = new Date(row.action_date).toLocaleDateString('en-GB');
         


    })

   
    if(data.currentStage.stage !='PL3'){

    const stagecurrent = document.getElementById(data.currentStage.stage);
    stagecurrent.querySelector('.step-name').textContent ="Waiting..."
    stagecurrent.classList.add("active")

    }else{

    const stagecurrent = document.getElementById("I1");
    stagecurrent.querySelector('.step-name').textContent ="Date Rejected"
     stagecurrent.querySelector('.step-id').textContent ="--"
     stagecurrent.querySelector('.step-counter').textContent = 'X';
    stagecurrent.classList.add("rejected")
    stagecurrent.querySelector('.step-date').textContent =  new Date(data.currentStage.created_at).toLocaleDateString('en-GB');


    }

}


    const requestor = document.getElementById("requestor");

    // Remove previous status classes
    requestor.classList.remove("completed", "warning");

    // Set status icon and class
    if (data.currentStage.stage !== 'I2') {
        requestor.querySelector('.step-counter').textContent = '✓';
        requestor.classList.add("completed");
    } else {
        requestor.querySelector('.step-counter').textContent = '⚠️';
        requestor.classList.add("warning");
    }

    // Set requestor information
    requestor.querySelector('.step-id').textContent = data.requestor.req_id;
    requestor.querySelector('.step-name').textContent = data.requestor.req_name;
    requestor.querySelector('.step-date').textContent =
        new Date(data.requestor.issuedate).toLocaleDateString('en-GB');

    }catch (error) {

        console.error(error);

    }
   

}









function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);







</script>

    
