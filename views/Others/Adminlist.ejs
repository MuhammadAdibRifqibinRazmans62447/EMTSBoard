<div class="modal fade"
     id="ApproveModal"
     tabindex="-1"
     data-bs-backdrop="static"
     aria-labelledby="ApproveModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered" style="max-width: 90%;">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="ApproveModalLabel">
                    Approve Date
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>


            <!-- BODY -->
            <div class="modal-body">

                <form id="resubmitDate"
                      method="POST"
                      action="/E-mts/board/updateDate">

                    <div class="row g-3">

                        <!-- M NUMBER -->
                        <div class="form-group col-sm-6">

                            <label for="Mnumber" class="form-label">
                                M Number
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="Mnumber"
                                   id="Mnumber"
                                   readonly>

                        </div>

                      
                        <!-- RECEIVE DATE -->
                        <div class="form-group col-sm-6">
                            <input type="hidden" id="originalReceiveDate" name="originalReceiveDate">
                            <label for="receiveDate" class="form-label">
                                Receive Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="receiveDate"
                                   id="receiveDate"
                                   required>

                        </div>




                        <!-- RECOMMENDED DATE -->
                         
                        <div class="form-group col-sm-6 "
                             id="recommendedDateDiv">

                            <label for="recommendedDate" class="form-label">
                                Recommended Date
                                <span class="text-danger"></span>
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="recommendedDate"
                                   id="recommendedDate" readonly>

                        </div>


                        <!-- REASON -->
                        <div class="form-group col-sm-6 "
                             id="modalreason">

                            <label for="reason" class="form-label">
                                Reason
                                <span class="text-danger"></span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="reason"
                                   id="reason" readonly>

                        </div>

                    </div>

                </form>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button type="submit"
                            id="submitApprove"
                            class="btn btn-primary"
                            form="resubmitDate">
                        Submit
                    </button>

                    <button type="button"
                            id="CancleRequest"
                            class="btn btn-danger"
                            onclick="cancleRequest()">
                        Cancel Request
                    </button>

            </div>

        </div>
    </div>

</div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
