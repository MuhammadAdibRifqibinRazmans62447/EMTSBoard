<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet" href="/css/form.css">
<link rel="stylesheet" href="/css/header.css">

    <title>E-MTS</title>
     


</head>

<body>

       <% if (user.rc === 'Approval') { %>

    <%- include('../partials/headerSV') %>

<% } else { %>

    <%- include('../partials/header') %>

<% } %>


<div class="container-fluid px-4" style="margin-top: 100px;">

    <h1 class="mt-4 text-center">Material Transaction Sheet</h1>

    <div class="row">
            <div class="col-12 d-flex justify-content-end">
                <button type="button" 
                        class="btn btn-danger"
                        style="font-size:20px;"
                        id="internal" disabled>
                    Internal&nbsp;Use&nbsp;Only
                </button>
            </div>
    </div>

   

    <div class="card mb-4">
        <div class="card-body">
            <form method="post" action="/E-mts/board/submitApproval">
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="col-md-12">
                            Issue Date:
                            <%= new Date(reqdetail.issuedate).toLocaleDateString('en-GB') %>
                            </div>
                        </div>
                       <div style="height:10px;"></div>
                        <div class="row">
                            <div class="col-md-12">
                                <table>
                                    <tr>
                                        <td></td>
                                        <td><b>Requestor</b></td>
                                        <td><b>Approval 1</b></td>
                                        <td><b>Approval 2</b></td>
                                        <td><b>Approval 3</b></td>


                                    </tr>

                                    <tr>
                                       <td>Name&nbsp;:</td>
                                       <td><input type="text" class="form-control" id="requestorName" name="requestorName" value="<%= reqdetail.req_name %>" readonly /> </td>
									   <td><input type="text" class="form-control"  id="approval1Name" name="approval1Name" value="<%= user.name %>" readonly></td>
									   <td><input type="text" class="form-control"  id="approval2Name" name="approval2Name" readonly></td>
									   <td><input type="text" class="form-control"  id="approval3Name" name="approval3Name" readonly></td>


                                    </tr>

                                    <tr>
									  <td>ID&nbsp;:</td>
									  <td><input type="text" class="form-control" id="requestorID" name="requestorID"  value="<%= reqdetail.req_id %>" readonly /></td>
									  <td><input type="text" class="form-control"  id="approval1ID" name="approval1ID" value="<%= user.id %>" readonly></td>
									  <td><input type="text" class="form-control"  id="approval2ID" name="approval2ID" readonly></td>
									  <td><input type="text" class="form-control"  id="approval3ID" name="approval3ID" readonly></td>
									</tr>

                                    <tr>
										<td>DEPT&nbsp;:</td>
										<td><input type="text" class="form-control"  id="requestorDep" name="requestorDep" value="<%= reqdetail.req_dep %>" readonly /></td>
										<td><input type="text" class="form-control"  id="approval1Dep" name="approval1Dep" value="<%= user.dept%>" readonly></td>
										<td><input type="text" class="form-control"  id="approval2Dep" name="approval2Dep" readonly></td>
										<td><input type="text" class="form-control" id="approval3Dep" name="approval3Dep" readonly></td>
									</tr>

									<tr>
										<td>EXT&nbsp;:</td>
										<td><input type="text" class="form-control"  id="requestorExt" name="requestorExt"  value="<%= reqdetail.req_ext %>" readonly/></td>
										<td><input type="text" class="form-control" id="approval1Ext" name="approval1Ext" value="<%= user.ext %>" readonly></td>
										<td><input type="text" class="form-control"  id="approval2Ext" name="approval2Ext" readonly></td>
										<td><input type="text" class="form-control"  id="approval3Ext" name="approval3Ext" readonly></td>
									</tr>
									<tr>
										<td>DATE/TIME&nbsp;:</td>
										<td>
											<input type="text" 
												class="form-control" 
												id="requestorDateTime" 
												name="requestorDateTime"  
												 value=" <%= new Date(reqdetail.req_datetime).toLocaleString('en-GB', {
                                                                day: '2-digit',
                                                                month: 'short',
                                                                year: 'numeric',
                                                                hour: '2-digit',
                                                                minute: '2-digit',
                                                                second: '2-digit'
                                                            }) %>"  readonly />
										</td>
										<td><input type="text" class="form-control" id="approval1DateTime" name="approval1DateTime" readonly></td>
										<td><input type="text" class="form-control"  id="approval2DateTime" name="approval2DateTime" readonly></td>
										<td><input type="text" class="form-control"  id="approval3DateTime" name="approval3DateTime" readonly></td>
									</tr>




                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row">

                            <table>
								<tr>
									<td ><b>MTS&nbsp;No:&nbsp;</b></td>
									<td><input type="text" readonly id="mtsno" name="mtsno" value="<%= reqdetail.MNumber%>" readonly></td>
								</tr>
								<tr>
									<td><b>Recieve Date:&nbsp;</b></td>
									    <td>
                                            <input 
                                                type="date" 
                                                id="receiveDate" 
                                                name="receiveDate"
                                                min="" disabled>

                                                <label>
                                                    <input type="radio" name="dateoption" value="yes" onclick="toggledate(true)">
                                                     Set date
                                                </label>
                                                 <label>
                                                    <input type="radio" name="dateoption" value="no" onclick="toggledate(false)">
                                                     No date
                                                </label>
                                        </td>

								</tr>
							</table>
                            <table >
								<!-- <tr >
									<td width="10%"><input type="button" class="btn btn-secondary" value="A"></td>
									<td width="20%">-&nbsp;Warehouse&nbsp;Transfer:</td>
									<td width="70%"><input type="text"  id="whtranser" name="whtranser"></td>
								</tr> -->
								<tr>
									<td><input type="button" class="btn btn-secondary" value="A"></td>
									<td>-&nbsp;Return&nbsp;JOC:</td>
									<td><input type="text" id="returnjoc" name="returnjoc"  value="<%= reqdetail.returnjoc%>"  readonly></td>
								</tr>
								<tr>
									<td><input type="button" class="btn btn-secondary" value="B"></td>
									<td>-&nbsp;Issue&nbsp;JOC:</td>
									<td>
									<input 
																type="text" 
																id="issuejoc" 
																name="issuejoc" 
																value="<%= reqdetail.issuejoc %>"  readonly>
									</td>
								</tr>
								<tr>
								    <td><input type="button" class="btn btn-secondary" value="C"></td>
									<td>-&nbsp;Spoilage&nbsp;JOC&nbsp;/&nbsp;WS:</td>
									<td><input type="text"  id="spoilagejoc" name="spoilagejoc" value="<%= reqdetail.spoilagejoc %>"    readonly></td>
                                    <input type="hidden"  id="jocdet" name="jocdet" value="reqdetail.approve_dep" >
								</tr>
								<!-- <tr>
									<td><input type="button" class="btn btn-secondary" value="E"></td>
									<td>-&nbsp;RTS&nbsp;/&nbsp;HANDOVER:</td>
									<td >
								         <select id="rtshandover" name="rtshandover">
												<option value="" selected disabled>Select Type</option>
												<option value="RTS">RTS</option>
												<option value="PANEL">PANEL</option>
										 </select>
									</td>
														
								</tr> -->
								 <!-- <tr>
									<td><input type="button" class="btn btn-secondary" value="F"></td>
									<td>-&nbsp;S.O&nbsp;No:</td>
									<td><input type="text"  id="sono" name="sono"></td>
								</tr> -->
								<!-- <tr>
									<td><input type="button" class="btn btn-secondary" value="G"></td>
									<td>-&nbsp;Customer:</td>
									<td><input type="text"  id="customer" name="customer"></td>
								</tr> -->

							</table>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <table id="ItemTable" style="margin:auto;">

                            <tr style="font-size:12px;">
								<th class="text-center">ITEM&nbsp;NO</th>
								<th class="text-center">ITEM&nbsp;DESC</th>
								<th class="text-center">ITEM&nbsp;CAT</th>
								<!-- <th class="text-center">FROM&nbsp;WHS</th>
								<th class="text-center">TO&nbsp;WHS</th> -->
								<th class="text-center">REQ&nbsp;QTY</th>
								<!-- <th class="text-center">ISSUE&nbsp;QTY</th> -->
								<th class="text-center">REMARK</th>
							
													

							</tr>

                                    <% Requests.forEach((Request, index) => { %>
                                    <tr>
                                        <td>
                                            <input
                                                type="text"
                                                class="form-control itemno "
                                                id="itemno<%= index + 1 %>"
                                                name="itemno[]"
                                                value="<%= Request.itemno %>"
                                                readonly>
                                        </td>

                                        <td>
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="itemdesc<%= index + 1 %>"
                                                name="itemdesc[]"
                                                style="width:100%;"
                                                value="<%= Request.itemdesc %>"
                                                readonly>
                                        </td>

                                        <td>
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="itemcat<%= index + 1 %>"
                                                name="itemcat[]"
                                                style="width:100%;"
                                                value="<%= Request.itemcat %>"
                                                readonly>
                                        </td>

                                        <td>
                                            <input
                                                type="number"
                                                class="form-control reqqty"
                                                id="reqqty<%= index + 1 %>"
                                                name="reqqty[]"
                                                style="width:100%;"
                                                value="<%= Request.reqqty %>"
                                                required>
                                        </td>

                                        <td>
                                            <input
                                                type="text"
                                                class="form-control remark"
                                                id="remark<%= index + 1 %>"
                                                name="remark[]"
                                                style="width:100%;"
                                                value="<%= Request.remark || '' %>"
                                                required>
                                        </td>

                                                <td>
                                                    <input
                                                        type="hidden"
                                                        class="approval"
                                                        name="approval[]"
                                                        value="">
                                                </td>

                                        <td class="text-center">
                                            <input
                                                type="button"
                                                class="btn btn-secondary approve"
                                                value="Approve" onclick="approve(this)">
                                        </td>

                                        <td class="text-center">
                                            <input
                                                type="button"
                                                class="btn btn-secondary reject"
                                                value="Reject" onclick="reject(this)">
                                        </td>
                                        <td class="text-center">
                                            <input
                                                type="button"
                                                class="btn btn-secondary Reset"
                                                value="Reset"
                                                onclick="resetRow(this)">
                                        </td>
                                    </tr>
                                    <% }) %>


                        </table>
                    </div>
                </div>
                		<div class="row">
							<div class="col-md-12 text-center">
									<input type="submit" class="btn btn-primary" value="Submit" onclick="return validateSubmit()">
							</div>
						</div>

            </form>
        </div>
    </div>
</div>



    
<script>
function toggledate(enable){

    const dateform = document.getElementById('receiveDate');

    dateform.disabled = !enable;
    dateform.required = true;

    if (!enable) {
        dateform.value = "";
        dateform.required = false;
    }
}


    const dateInput = document.getElementById("receiveDate");

    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);

    const formattedDate = tomorrow.toISOString().split("T")[0];

    dateInput.min = formattedDate;
	

    function approve(btn){

        let row = btn.closest("tr");
        let approval = row.querySelector(".approval")
        let cls = row.querySelectorAll(".form-control");
        let btnreject = row.querySelector(".reject")
        let qtyform = row.querySelector(".reqqty");
        let remarkform = row.querySelector(".remark");
        console.log(cls);
       
       qtyform.readOnly = true;
       remarkform.readOnly = true;

       if(row.classList.contains("highlight-rej")){

        row.classList.remove("highlight-rej")

       }

        row.classList.add("highlight-row");

        btn.disabled= true;

        if(btnreject.disabled){
            btnreject.disabled = false;
        }

        approval.value = "approve";




    }



     function reject(btn){

        let row = btn.closest("tr");
        let approval = row.querySelector(".approval")
        let cls = row.querySelectorAll(".form-control");
        let btnapprove = row.querySelector(".approve")
        let qtyform = row.querySelector(".reqqty");
        let remarkform = row.querySelector(".remark");
        console.log(cls);
       
       qtyform.readOnly = true;
       remarkform.readOnly = true;
      if(row.classList.contains("highlight-row")){

        row.classList.remove("highlight-row")

       }

        row.classList.add("highlight-rej");

        btn.disabled= true;

        if(btnapprove.disabled){
            btnapprove.disabled = false;
        }

        approval.value = "reject";




    }

function resetRow(btn){

    let row = btn.closest("tr");

    let approval = row.querySelector(".approval");
    let btnapprove = row.querySelector(".approve");
    let btnreject = row.querySelector(".reject");
    let qtyform = row.querySelector(".reqqty");
    let remarkform = row.querySelector(".remark");

    if (qtyform) qtyform.readOnly = false;
    if (remarkform) remarkform.readOnly = false;

    row.classList.remove("highlight-row");
    row.classList.remove("highlight-rej");

    if (btnapprove) btnapprove.disabled = false;
    if (btnreject) btnreject.disabled = false;

    if (approval) approval.value = "";
}


function validateSubmit(){

    // Check JOC
    const dateoption = document.querySelector('input[name="dateoption"]:checked');
    const rdate = document.getElementById("receiveDate");

    console.log("Validation started");
    console.log(dateoption?.value);

                if (!dateoption) {
                alert("Please select whether to set a receive date or not.");
            const row = rdate.closest("tr");

            row.classList.add("highlight-nodate");

            row.addEventListener("animationend", function () {
                row.classList.remove("highlight-nodate");
            }, { once: true });
                return false;
            }
    if(dateoption && dateoption.value === "yes"){

       

        if(rdate.value === ""){

            alert("Please enter valid receive date");

            rdate.closest("tr").classList.add("highlight-nodate");

            return false;
        }
    }



    // Check item rows

    const reqqty = document.getElementsByName("reqqty[]");
    const remark = document.getElementsByName("remark[]");
    const approval = document.getElementsByName("approval[]");


    for(let i = 0; i < reqqty.length; i++){

        if(reqqty[i].value.trim() === "" || reqqty[i].value <= 0){
            alert(`Please enter valid quantity at row ${i+1}`);
            reqqty[i].focus();
            return false;
        }

        if(remark[i].value.trim() === ""){
            alert(`Please enter Remark at row ${i+1}`);
            remark[i].focus();
            return false;
        }

        if(approval[i].value.trim() === ""){
            alert(`Please approve or reject this item ${i+1}`);
            approval[i].focus();
            return false;
        }
    }



    return true;
}




const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();







function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}


    function setRequestDateTime() {
        const now = new Date();

        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');

        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');

        const dateTime = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;

        document.getElementById("approval1DateTime").value = dateTime;
    }

    setRequestDateTime();

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);



</script>


    
</body>
</html>