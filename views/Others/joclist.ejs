<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css">

        <link rel="stylesheet" href="/css/header.css">
        <link rel="stylesheet" href="/css/joctable.css">
    <title>JOC</title>
</head>
<body>

    <%- include('../partials/headerSV') %>
    <% if(success.length > 0){ %>
    <div class="alert alert-success">
        <%= success[0] %>
    </div>
<% } %>

<% if (error.length > 0) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

    <br>
    <br>
    <h1 class="mt-4 text-center">JOC Management</h1>
    <br>
    <br>
    <br>


    <div class="container my-4">
            <div class="d-flex justify-content-end align-items-center gap-2 sp">
                <input
                    type="text"
                    id="searchInput"
                    class="form-control"
                    placeholder="Search users..."
                    style="width: 250px;">

                <button data-bs-toggle="modal" data-bs-target="#exampleModal">
                    <span>ADD</span>
                </button>
            </div>        
  <div class="card request-card shadow border-0 rounded-4">

    <div class="card-header text-white text-center fw-bold rounded-top-4">
      <img src="/img/dollar.svg" width="18" height="18"></i> JOC List
    </div>

    <div class="card-body p-0">

      <div class="table-container">

        <table id="myTable" class="table table-hover align-middle text-center mb-0">

          <thead>
            <tr>
              <th>No</th>
              <th>JOC</th>
              <th>Status</th>
              <th>Remark</th>
              <th>Action</th>
            </tr>
          </thead>


          <tbody>

         <% if (lists.length > 0) { %>

            <% lists.forEach((list,index) => { %>
            <tr>
                <td>
                  <%= index + 1%>
                </td>

                

              <td>
                  <%= list.JOC%>
                </td>



              <td>
                    <%
                        let stageText = list.active == 1 ? 'Active' : 'Deactive';
                        let badgeClass = list.active == 1 ? 'bg-success' : 'bg-danger';
                    %>

                    <span class="badge <%= badgeClass %>">
                        <%= stageText %>
                    </span>
                </td>

             <td>
                  <%= list.remark%>
             </td>

                <td>
                    <div 
                        class="tbBtn editBtn"
                        data-bs-toggle="modal"
                        data-bs-target="#EditModal"
                        data-joc="<%= list.JOC%>"
                        data-remark="<%= list.remark%>">
                        Edit
                  </div>
                    <div class="tbBtn switchbtn" 
                        onclick="switchStatus('<%= list.JOC%>', '<%= list.active %>')">
                        Switch
                    </div>

                      <div class="tbBtn deletebtn" 
                        onclick="deleteJOC('<%= list.JOC%>')">
                           Delete
                    </div>

                </td>




            </tr>

         <% }) %>

          <% } else { %>

            <tr>
              <td colspan="12" class="text-muted py-4">
                NO DATA
              </td>
            </tr>

          <% } %>
           </tbody>

        </table>

      </div>

    </div>

  </div>

</div>


<div class="modal fade" id="exampleModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Add JOC</h1>

        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>

      <div class="modal-body">

        <form id="addjocform" method="POST" action="/E-mts/board/addJOC">

          <div class="row">

            <div class="col-sm-12">

              <div class="row g-3">



                <div class="form-group col-sm-6">
                  <label for="joc" class="form-label">
                    JOC <span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="joc" 
                         id="joc" 
                         required>
                </div>

                 <div class="form-group col-sm-6">
                  <label for="remark" class="form-label">
                    Remark <span class="text-danger"></span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="remark" 
                         id="remark" 
                         >
                </div>





                <div class="form-group col-sm-6">

                <input type="text" 
                    class="form-control" 
                    name="Department" 
                    id="Department" 
                    value="<%= user.dept %>" 
                    readonly>

                  
                </div>


              </div>

            </div>

          </div>

        </form>

      </div>


      <div class="modal-footer">

        <button type="button" 
                class="btn btn-secondary" 
                data-bs-dismiss="modal">
          Close
        </button>


        <!-- Connected to addUserForm -->
        <button type="submit" 
                id="submitAdd" 
                class="btn btn-primary"
                form="addjocform">
          Submit
        </button>

      </div>


    </div>
  </div>

</div>




<div class="modal fade" id="EditModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="EditModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Edit JOC</h1>

        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="modal" 
                aria-label="Close">
        </button>
      </div>


      <div class="modal-body">

        <form id="EditUserForm" method="POST" action="/E-mts/board/editJOC">

          <div class="row">

            <div class="col-sm-12">

              <div class="row g-3">

                <div class="form-group col-sm-6">
                  <label for="edit_joc" class="form-label">
                    JOC<span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="edit_joc" 
                         id="edit_joc" 
                         required
                        readonly>
                </div>


                <div class="form-group col-sm-6">
                  <label for="edit_remark" class="form-label">
                    Remark <span class="text-danger">*</span>
                  </label>

                  <input type="text" 
                         class="form-control" 
                         name="edit_remark" 
                         id="edit_remark" 
                         required>
                </div>



              </div>

            </div>

          </div>

        </form>

      </div>


      <div class="modal-footer">

        <button type="button" 
                class="btn btn-secondary" 
                data-bs-dismiss="modal">
          Close
        </button>


        <!-- Connected to addUserForm -->
        <button type="submit" 
                id="submitEdit" 
                class="btn btn-primary"
                form="EditUserForm">
          Submit
        </button>

      </div>


    </div>
  </div>

</div>





<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const searchInput = document.getElementById("searchInput");
const table = document.getElementById("myTable");
const rows = table.querySelectorAll("tbody tr");

searchInput.addEventListener("keyup", function () {
    const keyword = this.value.toLowerCase();

    rows.forEach(row => {
        const text = row.textContent.toLowerCase();

        row.style.display = text.includes(keyword) ? "" : "none";
    });
});


document.querySelectorAll(".editBtn").forEach(item => {

    item.addEventListener("click", function () {

        document.getElementById("edit_joc").value = this.dataset.joc;
        document.getElementById("edit_remark").value = this.dataset.remark;

    });

});

async function  switchStatus(joc,active){

      const response = await fetch(`/E-mts/board/jocSwitch/${joc}/${active}`, {
            method: "POST"
        });


        if (!response.ok) {
              throw new Error("Server error");
         }
        location.reload();
}


async function deleteJOC(joc) {

    const confirmed = confirm(
        "Are you sure you want to delete this joc?"
    );

    if (!confirmed) {
        return;
    }

    try {

        const response = await fetch(`/E-mts/board/deleteJOC/${joc}`, {
            method: "POST"
        });

        if (!response.ok) {
            throw new Error("Server error");
        }

        location.reload();

    } catch (error) {

        console.error(error);
        alert("Failed to delete joc.");

    }
}

const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");





const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();







function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);

</script>
    
</body>
</html>