const hrsEl = document.getElementById("hrs");
const minEl = document.getElementById("min");
const secEl = document.getElementById("sec");

const dayEl = document.getElementById("day");
const monthEl = document.getElementById("month");
const yearEl = document.getElementById("year");

const pad = (n) => String(n).padStart(2, "0");

// set date once (static)
const today = new Date();
dayEl.textContent = pad(today.getDate());
monthEl.textContent = pad(today.getMonth() + 1);
yearEl.textContent = today.getFullYear();

function updateClock() {
    const now = new Date();

    hrsEl.textContent = pad(now.getHours());
    minEl.textContent = pad(now.getMinutes());
    secEl.textContent = pad(now.getSeconds());
}

// initial render
updateClock();

// sync clock (better than drifting intervals)
setInterval(updateClock, 1000);
</script>

    
