<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>lOGIN</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
    body {
     
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
    }
    .wrap {
      display: flex;            /* turn on flex */
      flex-wrap: wrap;          /* allow children to wrap on small screens */
      max-width: 800px;
      width: 100%;
      border-radius: 1rem;
      box-shadow: 0 8px 24px rgba(0,0,0,.15);
      overflow: hidden;
      background-color: #fff;
    }
    .wrap-left {
      flex: 1 1 300px;           /* flex grow/shrink basis */
      background-color: #121314ff;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .wrap-left img {
      max-width: 150px;
    }
    .wrap-right {
      flex: 1 1 300px;
      padding: 2rem;
      background-color: #fff;
    }

   .title {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .title h1 {
    font-size: 1.8rem;        /* adjust to fit inside the box */
    font-weight: 700;
    color: #17181aff;
    margin: 0;
  }
  .title h1::after {
    content: "";
    display: block;
    width: 40px;
    height: 3px;
    background-color: #0d6efd;
    margin: 0.5rem auto 0;
    border-radius: 2px;
  }


  .input-group-password {
    position: relative;
}

.input-group-password .form-control {
    width: 100%;
    padding-right: 45px;
}

/* Eye button */
.input-group-password .toggle-password-btn {
    position: absolute;
    top: 50%;
    right: 8px;
    transform: translateY(-50%);

    width: 32px;
    height: 32px;

    padding: 0;
    border: none;
    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #6c757d;
    cursor: pointer;
}

/* SVG */
.input-group-password .toggle-password-btn svg {
    width: 19px;
    height: 19px;
}

/* Hover */
.input-group-password .toggle-password-btn:hover {
    color: #212529;
}

input[type="password"]::-ms-reveal {
    display: none;
}

    </style>
</head>
<body>

      <div class="wrap mx-auto mt-5">
    <!-- Left panel: logo / branding -->
    <div class="wrap-left">
      <img src="/img/mtos.png"" alt="Logo">
    </div>

    <!-- Right panel: login form -->
    <div class="wrap-right">
<div class="title">
  <h1>E-MTS BOARD</h1>
</div>
<% if (alert) { %>
    <div class="alert alert-<%= alert.type %>" role="alert">
        <%= alert.message %>
    </div>
<% } %>

      <form method="post" action="/E-mts/login-board">
    
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" id="username" name="username" class="form-control" required>
        </div>
        <div class="mb-3">

          <label for="password" class="form-label">Password</label>
          <div class="input-group-password">
          <input type="password" id="password" name="password" class="form-control password-input" required>

                 <button type="button" class="toggle-password-btn" id="togglePassword1" aria-label="Show password as plain text.">

                             <!-- Eye On -->
                <svg class="icon-eye1" viewBox="0 0 24 24" fill="currentColor" >
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"></path>
                </svg>
                <!-- Eye Off (initially hidden) -->
                <svg class="icon-eye-off1" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                    <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"></path>
                </svg>
                           



                  </button>


          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
      </form>
    </div>
  </div>



<script>

document.querySelectorAll('.toggle-password-btn').forEach(button => {

    button.addEventListener('click', function () {

        // 1. Find the password container
        const container =
            this.closest('.input-group-password');

        // 2. Find the password input inside that container
        const password =
            container.querySelector('.password-input');

        // 3. Find the eye icons inside this button
        const eye =
            this.querySelector('.icon-eye1');

        const eyeOff =
            this.querySelector('.icon-eye-off1');

        // 4. Check whether password is currently hidden
        if (password.type === 'password') {

            // Show password
            password.type = 'text';

            // Change eye icon
            eye.style.display = 'none';
            eyeOff.style.display = 'block';

        } else {

            // Hide password
            password.type = 'password';

            // Change eye icon back
            eye.style.display = 'block';
            eyeOff.style.display = 'none';
        }

    });

});

</script>
    
</body>
</html>   